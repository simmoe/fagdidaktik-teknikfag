		"svelte-check": "^4.1.1",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.0",
		"vite": "^6.0.7"
	},
	"allowScripts": {
		"esbuild@0.25.12": true
	},
	"dependencies": {
		"@tiptap/core": "^3.32.2",
		"@tiptap/extension-link": "^3.32.2",
		"@tiptap/starter-kit": "^3.32.2",
		"firebase": "^12.17.1"
