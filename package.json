{
	"name": "fagdidaktik-teknikfag",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Noter og interaktion til fagdidaktik i teknikfag.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
